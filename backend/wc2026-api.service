[Unit]
Description=WC2026 Betting Predictor API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wc2026/backend
ExecStart=/opt/wc2026/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target