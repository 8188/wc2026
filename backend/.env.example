# WC2026 Betting Predictor - Backend Environment
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/wc2026.db

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# CORS - Frontend URL (Cloudflare Pages)
FRONTEND_URL=http://localhost:5173

# The Odds API (https://the-odds-api.com/)
ODDS_API_KEY=your_odds_api_key_here

# NewsAPI (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# API-Football (https://www.api-football.com/)
FOOTBALL_API_KEY=your_football_api_key_here

# OpenAI (for news sentiment analysis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Scheduler intervals (minutes)
ODDS_UPDATE_INTERVAL=120
NEWS_UPDATE_INTERVAL=30
INJURY_UPDATE_INTERVAL=360
PREDICTION_RECALC_INTERVAL=180
